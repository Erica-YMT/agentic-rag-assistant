# Application model provider
MODEL_API_KEY=
TAVILY_API_KEY=


# JWT authentication
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP email verification. Use an app password rather than your mailbox password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=1
SMTP_FROM=x'x'x@gmail.com
SMTP_USERNAME=x'x'x
SMTP_PASSWORD=x'x'x
